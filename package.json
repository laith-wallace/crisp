{
  "name": "@laith-wallace/crisp",
  "version": "1.11.1",
  "description": "CRISP design intelligence skills for AI agents: reviews, audits, accessibility, motion craft, DESIGN.md, and an edit-time design detector",
  "type": "module",
  "bin": {
    "crisp": "bin/crisp.mjs"
  },
  "files": [
    "bin/",
    "skills/",
    "scripts/",
    "hooks/",
    ".claude-plugin/",
    ".claude/skills/",
    ".agents/skills/",
    ".cursor/skills/",
    ".gemini/skills/"
  ],
  "scripts": {
    "sync": "node scripts/sync.mjs",
    "check": "node scripts/sync.mjs --check",
    "test": "node --test tests/unit/*.test.mjs && node scripts/sync.mjs --check",
    "install-global": "node scripts/install.mjs",
    "prepublishOnly": "node scripts/sync.mjs && node --test tests/unit/*.test.mjs"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@clack/prompts": "^0.9.0",
    "chalk": "^5.3.0",
    "figlet": "^1.7.0"
  },
  "keywords": [
    "accessibility",
    "agent-skills",
    "ai",
    "anti-slop",
    "claude",
    "claude-code",
    "codex",
    "crisp",
    "cursor",
    "design",
    "design-md",
    "design-review",
    "gemini-cli",
    "microcopy",
    "skills",
    "ux"
  ],
  "author": "Laith Wallace",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/laith-wallace/crisp.git"
  },
  "homepage": "https://github.com/laith-wallace/crisp"
}
